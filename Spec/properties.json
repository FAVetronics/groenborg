/*** Log files ***/

{
	"property" : "logFileControl",
	"getLogFiles" : 1,
	"object_id": "161695209555" // file reference
	"expirationTime" : "230831-16:57:36.012291"
//		Causes AllLogs.zip to be sent to <host>/api/mobile/receive-log/<location>/						
//		where <host> is set in settings.ini:	
//			https://comforttanpay.com/ #Production server
//			http://comforttan-dev.vsrv105.vmc1.systemina.dk/ #Staging server
}

{
	"property" : "logFileStatus",
	"status" : 0 //
//		0: OK / complete
//		2: transmission error
//		3: zip error
	"timeStamp" : "230831-16:57:36.012291"
}



/*** Upload files ***/
{
	"property" : "uploadFileControl",
	"path" : "http://.../",
	"name" : "version_nn.zip",
	"MD5" : "1234"
	"expirationTime" : "230831-16:57:36.012291"
//		Uploads the file given in path/file, verify MD5,
//		unzips file to the grønborg folder, delete zip file
}

{
	"property" : "uploadFileStatus",
	"status" : 0 
//		0: OK / complete
//		1: MD5 error
//		2: transmission error
//		3: zip error
	"timeStamp" : "230831-16:57:36.012291"
}



/*** Disable message expiration function ***/
{
	"property" : "diableMessageExpiration"
}
// To be used in case of misaligned clocks (eg. summer-/winter-time)
// Disables the check of expiration time on telegrams received.
// Must be sent after reset before the "settings" telegram.
// Cleared at reboot

